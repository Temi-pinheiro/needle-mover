# Comments live on their own line, never after a value.
# Some .env parsers fold a trailing "# comment" into the value, which turns a
# working credential into one that fails without saying why.

# ---- generated locally: pnpm keygen ----
# Protects the Linear API keys at rest.
ENCRYPTION_KEY=

# ---- Anthropic ----
ANTHROPIC_API_KEY=

# ---- Supabase: Project settings → API ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never referenced from a client component.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Google: sign-in only, no calendar scope ----
# Cloud console → OAuth client, type "Web application".
# One authorised redirect URI, which Supabase gives you:
#   https://<your-project>.supabase.co/auth/v1/callback
# Then paste the same client id and secret into
# Supabase → Authentication → Providers → Google.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- App ----
NEXT_PUBLIC_APP_URL=http://localhost:3000
# The single Google account permitted to sign in. Address only, nothing else.
ALLOWED_EMAIL=

# ---- Deepgram: optional, voice capture only ----
# Leave unset and the mic button does not appear; typed capture still works.
# console.deepgram.com → API keys. Nova-3, pre-recorded.
DEEPGRAM_API_KEY=
# Names Deepgram should listen for, comma-separated: clients, people, products
# that are not already a venture or project name in Linear (those are sent
# automatically). Example: Dayo,Adaeze,Meridian
DEEPGRAM_KEYTERMS=
