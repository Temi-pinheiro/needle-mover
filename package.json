{
  "name": "needle-mover",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "linear:check": "tsx --env-file-if-exists=.env.local scripts/linear-check.ts",
    "keygen": "tsx scripts/keygen.ts",
    "db:types": "supabase gen types typescript --linked > src/lib/db/generated.ts",
    "seed": "tsx --env-file-if-exists=.env.local scripts/setup.ts",
    "migrations": "tsx --env-file-if-exists=.env.local scripts/migration-status.ts",
    "env:check": "tsx --env-file-if-exists=.env.local scripts/env-check.ts",
    "scope": "tsx --env-file-if-exists=.env.local scripts/scope-venture.ts",
    "capture:check": "tsx --env-file-if-exists=.env.local scripts/capture-check.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.126.0",
    "@phosphor-icons/react": "^2.1.10",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "google-auth-library": "^11.1.0",
    "html-to-image": "^1.11.13",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sonner": "^2.0.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5",
    "vitest": "^5.0.1"
  },
  "packageManager": "pnpm@9.15.0"
}
